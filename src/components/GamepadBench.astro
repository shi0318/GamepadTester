---
interface Props { mode?: string; compact?: boolean; }
const { mode = 'full', compact = false } = Astro.props;
const buttonGroups = [
  { label: 'Face buttons', items: [{ index: 0, label: 'A' }, { index: 1, label: 'B' }, { index: 2, label: 'X' }, { index: 3, label: 'Y' }] },
  { label: 'Shoulders & triggers', items: [{ index: 4, label: 'LB' }, { index: 5, label: 'RB' }, { index: 6, label: 'LT' }, { index: 7, label: 'RT' }] },
  { label: 'Menu & stick clicks', items: [{ index: 8, label: 'Back' }, { index: 9, label: 'Start' }, { index: 10, label: 'L3' }, { index: 11, label: 'R3' }] },
  { label: 'Directional & system', items: [{ index: 12, label: 'D-pad up' }, { index: 13, label: 'D-pad down' }, { index: 14, label: 'D-pad left' }, { index: 15, label: 'D-pad right' }, { index: 16, label: 'Home' }, { index: 17, label: 'Touchpad' }] },
];
const modeLabels: Record<string, string> = { full: 'Full controller test', drift: 'Stick drift diagnostic', buttons: 'Button input test', vibration: 'Vibration test', triggers: 'Trigger travel test', polling: 'Browser sample-rate test', ps5: 'DualSense controller test', xbox: 'Xbox controller test', switch: 'Switch controller test' };
const modeLabel = modeLabels[mode] || modeLabels.full;
---

<section class:list={["game-section", compact && "game-section-compact"]} id="tester" data-gamepad-tool={mode} aria-labelledby="game-heading">
  <div class="game-heading-row">
    <div><p class="eyebrow">LIVE GAMEPAD DIAGNOSTICS</p><h2 id="game-heading">Connect your gamepad</h2><p class="mode-label" id="mode-label">{modeLabel}</p></div>
    <div class="game-controls"><label class="controller-picker-label" for="controller-select">Controller</label><select id="controller-select" aria-label="Choose controller"><option value="-1">No controllers detected</option></select><button class="reset-button" id="reset-test" type="button">Reset test</button></div>
  </div>
  <div class="connection-banner" id="connection-banner"><span class="banner-icon" aria-hidden="true">↯</span><div><strong id="banner-title">Press any button to connect</strong><p id="banner-copy">Plug in via USB or pair over Bluetooth, then press a button on your controller.</p></div><span class="banner-status" id="banner-status">WAITING</span></div>
  <div class="gamepad-grid">
    <article class="controller-card panel"><div class="panel-topline"><div><span class="panel-label">CONTROLLER 01</span><h3 id="controller-name">No controller detected</h3></div><span class="live-badge" id="live-badge"><span class="status-dot"></span> Offline</span></div>
      <div class="controller-visual"><div class="controller-shell"><div class="controller-shoulders"><span data-button="4"></span><span data-button="5"></span></div><div class="controller-grip grip-left"></div><div class="controller-grip grip-right"></div><div class="controller-center"><div class="controller-screen"><span>GAMEPAD</span><strong>READY</strong></div><div class="center-buttons"><span data-button="8"></span><span data-button="16"></span><span data-button="9"></span></div></div><div class="stick stick-left"><i id="left-stick-visual"></i></div><div class="stick stick-right"><i id="right-stick-visual"></i></div><div class="dpad"><span class="dpad-up" data-button="12"></span><span class="dpad-right" data-button="15"></span><span class="dpad-down" data-button="13"></span><span class="dpad-left" data-button="14"></span><b></b></div><div class="face-buttons"><span class="face-y" data-button="3">Y</span><span class="face-x" data-button="2">X</span><span class="face-b" data-button="1">B</span><span class="face-a" data-button="0">A</span></div><div class="shoulder-labels"><span>LB</span><span>RB</span></div></div><div class="visual-hint" id="visual-hint"><span class="hint-pulse"></span> Waiting for input</div></div>
      <div class="button-summary"><span>Button events</span><strong id="event-count">0</strong><span class="summary-divider"></span><span>Last input</span><strong id="last-input">—</strong></div>
      <div class="button-matrix" aria-label="Complete button input map">
        <div class="matrix-heading"><span class="panel-label">COMPLETE INPUT MAP</span><span class="unit-label">PRESS EACH CONTROL</span></div>
        {buttonGroups.map((group) => <div class="button-group"><span class="button-group-label">{group.label}</span><div class="button-grid">{group.items.map((item) => <div class="button-cell" data-button-cell={item.index}><span>{item.label}</span><strong data-button-value={item.index}>0.00</strong></div>)}</div></div>)}
      </div>
    </article>
    <div class="telemetry-column">
      <article class="panel telemetry-panel" data-diagnostic="sticks"><div class="panel-topline"><div><span class="panel-label">ANALOG INPUT</span><h3>Stick telemetry</h3></div><span class="unit-label">LIVE X / Y</span></div><div class="stick-metrics"><div class="metric-block"><div class="metric-head"><span>Left stick</span><strong id="left-stick-status">CENTERED</strong></div><div class="axis-visual"><i class="axis-point" id="left-point"></i></div><div class="metric-values"><span>X <strong id="left-x">+0.00</strong></span><span>Y <strong id="left-y">+0.00</strong></span></div></div><div class="metric-block"><div class="metric-head"><span>Right stick</span><strong id="right-stick-status">CENTERED</strong></div><div class="axis-visual"><i class="axis-point" id="right-point"></i></div><div class="metric-values"><span>X <strong id="right-x">+0.00</strong></span><span>Y <strong id="right-y">+0.00</strong></span></div></div></div></article>
      <article class="panel diagnostics-panel" data-diagnostic="drift"><div class="panel-topline"><div><span class="panel-label">DRIFT & DEADZONE</span><h3>Stick health check</h3></div><span class="unit-label" id="drift-verdict">WAITING</span></div><p class="panel-help">Leave the sticks untouched, then calibrate. The result measures the signal exposed by your browser.</p><div class="diagnostic-actions"><button class="text-button" id="calibrate-sticks" type="button">Calibrate center</button><span class="calibration-status" id="calibration-status">Not calibrated</span></div><div class="health-grid"><div><span>Center offset</span><strong id="center-offset">—</strong></div><div><span>Jitter</span><strong id="jitter-value">—</strong></div><div><span>Detection threshold</span><strong id="deadzone-value">0.12</strong></div><div><span>Drift score</span><strong id="drift-score">—</strong></div></div></article>
      <article class="panel diagnostics-panel" data-diagnostic="circularity"><div class="panel-topline"><div><span class="panel-label">STICK RANGE</span><h3>Circle test</h3></div><span class="unit-label" id="circle-verdict">READY</span></div><p class="panel-help">Choose a stick, click start, then rotate it around the edge once. The result is an estimate based on radius consistency and angle coverage.</p><div class="circle-controls"><select id="circle-stick" aria-label="Stick for circularity test"><option value="left">Left stick</option><option value="right">Right stick</option></select><button class="text-button" id="circle-test" type="button">Start circle</button></div><div class="health-grid circle-results"><div><span>Samples</span><strong id="circle-samples">0</strong></div><div><span>Min radius</span><strong id="circle-min">—</strong></div><div><span>Max radius</span><strong id="circle-max">—</strong></div><div><span>Angle coverage</span><strong id="circle-coverage">0%</strong></div><div><span>Radius score</span><strong id="circle-score">—</strong></div></div></article>
      <article class="panel compact-panel" data-diagnostic="triggers"><div class="panel-topline"><div><span class="panel-label">ANALOG BUTTONS</span><h3>Triggers</h3></div><span class="unit-label">0 — 1.00</span></div><div class="trigger-row"><div class="trigger-item"><div class="trigger-label"><span>LT / L2</span><strong id="lt-value">0.00</strong></div><div class="trigger-track"><i id="lt-bar"></i></div></div><div class="trigger-item"><div class="trigger-label"><span>RT / R2</span><strong id="rt-value">0.00</strong></div><div class="trigger-track"><i id="rt-bar"></i></div></div></div></article>
      <article class="panel compact-panel" data-diagnostic="vibration"><div class="panel-topline"><div><span class="panel-label">HAPTIC FEEDBACK</span><h3>Vibration test</h3></div><span class="unit-label" id="rumble-support">NOT READY</span></div><div class="vibration-actions"><button class="vibration-button" data-rumble="light" type="button">Light</button><button class="vibration-button" data-rumble="heavy" type="button">Heavy</button><button class="vibration-button" data-rumble="burst" type="button">Burst</button><button class="vibration-button" data-rumble="pulse" type="button">Pulse</button></div><div class="rumble-controls"><label for="strong-magnitude">Strong <output id="strong-output">80%</output></label><input id="strong-magnitude" type="range" min="0" max="100" value="80" /></div><div class="rumble-controls"><label for="weak-magnitude">Weak <output id="weak-output">60%</output></label><input id="weak-magnitude" type="range" min="0" max="100" value="60" /></div><button class="custom-rumble-button" data-rumble="custom" type="button">Run custom rumble</button></article>
    </div>
  </div>
  <div class="raw-data panel"><div class="raw-head"><div><span class="panel-label">RAW GAMEPAD API DATA</span><h3>Input snapshot</h3></div><button class="text-button" id="raw-toggle" type="button">Show details <span>+</span></button></div><div class="raw-preview"><div><span>Axes</span><strong id="raw-axes">0.00, 0.00, 0.00, 0.00</strong></div><div><span>Buttons pressed</span><strong id="raw-buttons">None</strong></div><div><span>Browser sample rate</span><strong id="sample-rate">—</strong></div><div><span>API mode</span><strong>Standard Gamepad</strong></div></div><pre class="raw-details" id="raw-details" hidden>{'{"status":"waiting_for_controller"}'}</pre></div>
  <p class="tester-disclaimer">Browser-side diagnostic only. Connect the controller in your operating system first; this page cannot pair Bluetooth or install drivers. Results depend on the browser, operating system, connection and controller mapping.</p>
</section>
<script>import '../scripts/gamepad-tester.js';</script>
