---
import type { AdapterProfile } from '../data/adapter-library';

interface Props { adapter: AdapterProfile; }
const { adapter } = Astro.props;
---

<article class="catalog-card adapter-card">
  <div class="catalog-card-topline"><span class="catalog-badge">{adapter.category}</span><span class="catalog-meta">{adapter.output}</span></div>
  <h2><a class="catalog-card-link" href={`/controller-adapters/${adapter.slug}/`}>{adapter.name}</a></h2>
  <p class="adapter-flow"><span>{adapter.input}</span><b>→</b><span>{adapter.output}</span></p>
  <p>{adapter.summary}</p>
  <p class="catalog-maker">For {adapter.target}</p>
  <strong class="catalog-link">Check adapter details →</strong>
</article>
