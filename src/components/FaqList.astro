---
import { FAQS } from '../data/site';
---

<section class="faq-section shell" id="faq"><div class="section-heading"><div><span class="section-kicker">NEED A HAND?</span><h2>Common questions</h2></div></div><div class="faq-grid">{FAQS.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>
