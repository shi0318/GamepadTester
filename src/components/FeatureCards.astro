---
import { TOOL_PAGES } from '../data/site';
import { CONTROLLER_LIBRARY_LINKS } from '../data/site';
---

<section class="feature-section shell"><div class="section-heading"><div><span class="section-kicker">TOOL MATRIX</span><h2>One controller. Every signal.</h2></div><p class="section-intro">Use the full bench for a quick check, or open a focused diagnostic when you need a deeper answer.</p></div><div class="feature-grid">{TOOL_PAGES.slice(0, 3).map((item, index) => <a class="feature-card" href={item.href}><span class="feature-number">0{index + 1}</span><span class:list={["feature-icon", index === 0 ? "green" : index === 1 ? "orange" : "purple"]}>{index === 0 ? '◎' : index === 1 ? '↯' : '⌁'}</span><h3>{item.label}</h3><p>{item.description}</p><span class="card-link">Open tool <span>→</span></span></a>)}</div><div class="ecosystem-links">{CONTROLLER_LIBRARY_LINKS.map((item) => <a class="ecosystem-link" href={item.href}><span class="ecosystem-link-icon">{item.href.includes('adapter') ? '⇄' : '⌕'}</span><span><strong>{item.label}</strong><small>{item.description}</small></span><em>Explore →</em></a>)}</div></section>
