---
import { TOOL_PAGES } from '../data/site';
import { CONTROLLER_LIBRARY_LINKS } from '../data/site';
---

<section class="feature-section shell"><div class="section-heading"><div><span class="section-kicker">TOOL MATRIX</span><h2>One controller. Every signal.</h2></div><p class="section-intro">Use the full bench for a quick check, or open a focused diagnostic when you need a deeper answer.</p></div><div class="feature-grid">{TOOL_PAGES.slice(0, 3).map((item, index) => <article class="feature-card"><span class="feature-number">0{index + 1}</span><span class:list={["feature-icon", index === 0 ? "green" : index === 1 ? "orange" : "purple"]}>{index === 0 ? '◎' : index === 1 ? '↯' : '⌁'}</span><h3><a class="catalog-card-link" href={item.href}>{item.label}</a></h3><p>{item.description}</p><span class="card-link">Open tool <span>→</span></span></article>)}</div><div class="ecosystem-links">{CONTROLLER_LIBRARY_LINKS.map((item) => <div class="ecosystem-link"><span class="ecosystem-link-icon">{item.href.includes('adapter') ? '⇄' : '⌕'}</span><span><strong><a class="catalog-card-link" href={item.href}>{item.label}</a></strong><small>{item.description}</small></span><em>Explore →</em></div>)}</div></section>
