---
import { SITE, TOOL_PAGES } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <section>
      <a class="brand footer-brand" href="/"><img src="/gamepad-tester-logo.svg" width="38" height="38" alt="Gamepad Tester controller logo" /><span>Gamepad<span class="brand-accent">Tester</span></span></a>
      <p class="footer-note">Browser-based controller diagnostics.<br />Fast, private, and built for players.</p>
    </section>
    <section><h2>Test</h2><ul>{TOOL_PAGES.slice(0, 5).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></section>
    <section><h2>Devices</h2><ul><li><a href="/ps5-controller-test/">PS5 DualSense</a></li><li><a href="/xbox-controller-test/">Xbox controller</a></li><li><a href="/switch-controller-test/">Switch controller</a></li><li><a href="/polling-rate-test/">Polling rate</a></li></ul></section>
    <section><h2>Explore</h2><ul><li><a href="/tools/">All tools</a></li><li><a href="/controllers/">Controller library</a></li><li><a href="/controller-adapters/">Adapter finder</a></li><li><a href="/gamepad-not-detected/">Not detected guide</a></li><li><a href="/about/">About this tester</a></li><li><a href="/privacy-policy/">Privacy policy</a></li></ul></section>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {SITE.name}</span><span>Input stays on your device.</span></div>
</footer>
