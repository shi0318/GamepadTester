---
import GamepadBench from './GamepadBench.astro';
import { TOOL_PAGES } from '../data/site';

interface Props { title: string; description: string; kicker: string; mode: string; intro: string; checks: string[]; notes: string[]; faq: { question: string; answer: string }[]; }
const { title, description, kicker, mode, intro, checks, notes, faq } = Astro.props;
// Section copy follows the test so focused pages do not repeat the same paragraphs.
const COPY: Record<string, { checks: string; notes: string; notesIntro: string }> = {
  buttons: { checks: 'Every control, one cell each', notes: 'Get a clean button pass', notesIntro: 'Work through the controller in a fixed order (face buttons, D-pad, shoulders, then stick clicks) so a missing cell stands out straight away.' },
  triggers: { checks: 'Travel, not just on and off', notes: 'Squeeze slowly', notesIntro: 'Press each trigger over two or three seconds. A healthy analog trigger climbs steadily instead of jumping straight to 1.00.' },
  drift: { checks: 'Movement at rest is the signal', notes: 'Let the sticks settle', notesIntro: 'Rest the controller on a flat surface and keep your thumbs off both sticks before locking the center, otherwise the reference includes your own pressure.' },
  calibration: { checks: 'A reference, not a firmware write', notes: 'Lock a clean center', notesIntro: 'Calibrate with the controller resting flat and untouched, then run one slow circle per stick. Rushed circles leave gaps in the angle coverage.' },
  vibration: { checks: 'Output support, not input', notes: 'Give rumble a fair chance', notesIntro: 'Select the controller in the picker and try the short Light pattern first. If nothing plays, switch to USB before assuming a motor fault.' },
  polling: { checks: 'Browser timing, measured honestly', notes: 'Keep conditions equal', notesIntro: 'Keep the tab in the foreground and the display refresh rate unchanged, because a background tab or a lower refresh rate throttles the count.' },
};
const copy = COPY[mode] ?? { checks: 'Measure the signal, not the guess', notes: 'Test conditions matter', notesIntro: 'Use a wired connection when possible, close other controller software, and press a button after the device is connected.' };
// Related links follow the next diagnostic step for each test rather than a fixed slice of the list.
const RELATED: Record<string, string[]> = {
  '/button-test/': ['/trigger-test/', '/stick-drift-test/', '/vibration-test/', '/polling-rate-test/'],
  '/trigger-test/': ['/button-test/', '/vibration-test/', '/ps5-controller-test/', '/xbox-controller-test/'],
  '/stick-drift-test/': ['/gamepad-calibration/', '/button-test/', '/trigger-test/', '/polling-rate-test/'],
  '/gamepad-calibration/': ['/stick-drift-test/', '/trigger-test/', '/button-test/', '/ps5-controller-test/'],
  '/vibration-test/': ['/trigger-test/', '/button-test/', '/ps5-controller-test/', '/xbox-controller-test/'],
  '/polling-rate-test/': ['/keyboard-latency-test/', '/stick-drift-test/', '/button-test/', '/mouse-dpi-test/'],
  '/ps5-controller-test/': ['/stick-drift-test/', '/trigger-test/', '/vibration-test/', '/xbox-controller-test/'],
  '/xbox-controller-test/': ['/stick-drift-test/', '/trigger-test/', '/vibration-test/', '/switch-controller-test/'],
  '/switch-controller-test/': ['/stick-drift-test/', '/button-test/', '/vibration-test/', '/ps5-controller-test/'],
};
const relatedHrefs = RELATED[Astro.url.pathname];
const related = relatedHrefs
  ? relatedHrefs.map((href) => TOOL_PAGES.find((item) => item.href === href)).filter((item) => item !== undefined)
  : TOOL_PAGES.filter((item) => item.href !== Astro.url.pathname).slice(0, 4);
---

<section class="article-hero"><div class="shell article-hero-inner"><span class="subpage-kicker">{kicker}</span><h1>{title}</h1><p class="lede">{intro}</p><a class="primary-button" href="#tester">Run this test <span>→</span></a></div></section>
<div class="tool-wrap"><GamepadBench mode={mode} compact /></div>
<section class="subpage-content shell"><article class="info-card"><span class="panel-label">WHAT IT CHECKS</span><h2>{copy.checks}</h2><p>{description}</p><ul>{checks.map((check) => <li>{check}</li>)}</ul></article><article class="info-card"><span class="panel-label">HOW TO GET A CLEAN RESULT</span><h2>{copy.notes}</h2><p>{copy.notesIntro}</p><ul>{notes.map((note) => <li>{note}</li>)}</ul></article><div class="tool-callout"><strong>Privacy by design:</strong> input data is read and processed locally by your browser. It is not uploaded to a server.</div></section>
<section class="related-tools shell"><div class="section-heading"><div><span class="section-kicker">KEEP TESTING</span><h2>Related tools</h2></div></div><div class="related-grid">{related.map((item) => <article class="related-card"><span>{item.kicker}</span><strong><a class="catalog-card-link" href={item.href}>{item.label}</a></strong><small>{item.description}</small><em>Open →</em></article>)}</div></section>
<section class="faq-section shell"><div class="section-heading"><div><span class="section-kicker">FAQ</span><h2>Questions about this test</h2></div></div><div class="faq-grid">{faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div></section>
