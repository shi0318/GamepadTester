---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'Why does button testing work but vibration does not?', answer: 'Button data and rumble output have different browser and driver support. A controller can be readable while its vibration actuator is unavailable to the page.' }, { question: 'Does this test PS5 adaptive triggers?', answer: 'The standard browser Gamepad API may expose trigger travel, but it does not universally control adaptive trigger resistance. This page focuses on rumble feedback.' }, { question: 'Is vibration guaranteed to work?', answer: 'No. Browser, operating system, connection type and controller support all affect rumble. This tool reports whether the browser exposes a vibration actuator.' }];
---
<BaseLayout title="Gamepad Vibration Test – Test Controller Rumble Online" description="Test controller vibration and rumble online. Check supported Xbox, PlayStation, Switch and PC gamepads with light, heavy and burst feedback patterns." faqs={faq}><ToolPage title="Feel every signal. Test your rumble." description="Check whether your controller's supported haptic feedback responds to light, heavy and burst rumble patterns." kicker="DIAGNOSTIC TOOL / 03" mode="vibration" intro="Send supported haptic patterns to your controller and confirm whether both connection and rumble output are healthy." checks={['Light, heavy and burst rumble patterns', 'Browser vibration actuator availability', 'USB and Bluetooth rumble differences', 'Controller and operating system support']} notes={['Use Chrome or Edge on desktop for broad support.', 'Try USB when Bluetooth rumble is missing.', 'Close Steam or other software that may own the controller.']} faq={faq} /></BaseLayout>
