---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOL_PAGES, TOOL_CATEGORIES } from '../../data/site';

const itemList = TOOL_PAGES.map((item) => ({ name: item.label, path: item.href, description: item.description }));
---

<BaseLayout title="Gamepad Testing Tools – Button, Drift, Keyboard Latency & Mouse DPI" description="Browse free browser diagnostics for controllers, keyboard latency and mouse DPI. Start with the full gamepad tester or open a focused input test." itemList={itemList} itemListName="Gamepad testing tools">
  <section class="article-hero"><div class="shell article-hero-inner"><span class="subpage-kicker">TOOLS</span><h1>All testing tools</h1><p class="lede">A tool index for controllers, keyboards and mice. Start with the full tester or open a focused diagnostic.</p></div></section>
  {TOOL_CATEGORIES.map((category) => {
    const tools = TOOL_PAGES.filter((item) => item.category === category.id);
    return (
      <section class="tools-index shell">
        <div class="section-heading">
          <div>
            <span class="section-kicker">{category.kicker}</span>
            <h2>{category.label}</h2>
          </div>
          <p class="section-intro">{category.description}</p>
        </div>
        <div class="tools-index-grid">
          {tools.map((item, index) => (
            <a class="tool-index-card" href={item.href}>
              <span>0{index + 1}</span>
              <small>{item.kicker}</small>
              <h2>{item.label}</h2>
              <p>{item.description}</p>
              <strong>Open tool →</strong>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>
