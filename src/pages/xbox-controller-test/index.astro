---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'Does this support Xbox Series and Xbox One controllers?', answer: 'Most modern Xbox and XInput-style controllers expose standard buttons, sticks and triggers through the browser Gamepad API.' }, { question: 'Why does my Xbox controller show as Xbox 360?', answer: 'Many drivers intentionally expose a standard XInput mapping for compatibility. The label does not necessarily mean the controller is an Xbox 360 model.' }];
---
<BaseLayout title="Xbox Controller Test Online – Test Xbox Buttons & Sticks" description="Test your Xbox, Xbox One or Xbox Series controller online. Check buttons, joysticks, triggers, D-pad and vibration in your browser." faqs={faq}><ToolPage title="Test your Xbox controller." description="Run a full browser-based Xbox controller check for XInput buttons, analog sticks, triggers, D-pad and rumble." kicker="DEVICE TEST / XBOX & XINPUT" mode="xbox" intro="Connect an Xbox or compatible XInput controller and inspect every signal without downloading a driver or app." checks={['A, B, X and Y face buttons', 'D-pad, bumpers and menu buttons', 'Left and right analog sticks', 'LT / RT travel and supported rumble']} notes={['Use USB when diagnosing connection issues.', 'Press a face button after the page loads.', 'Close Steam Input if the mapping looks unexpected.']} faq={faq} /></BaseLayout>
