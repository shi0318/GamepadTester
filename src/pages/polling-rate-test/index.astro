---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'Is browser polling rate the same as hardware polling rate?', answer: 'No. This page reports the browser animation-frame sample rate, which can be affected by display refresh rate, browser scheduling and system load.' }, { question: 'How should I compare wired and Bluetooth?', answer: 'Run the same movement pattern in both modes and compare the observed browser sample rate under the same browser and display conditions.' }];
---
<BaseLayout title="Gamepad Polling Rate Test – Browser Sample Rate Estimate" description="Estimate the browser sample rate for a connected gamepad. Compare input delivery over USB and Bluetooth, while understanding why this is not the controller's true hardware polling rate." faqs={faq}><ToolPage title="How often does the browser see input?" description="Use the live browser sample counter to compare input delivery under wired and wireless controller connections. It reports requestAnimationFrame timing, not a hardware polling specification." kicker="DIAGNOSTIC TOOL / 05" mode="polling" intro="A transparent browser-side estimate for input sampling—not a measurement of the controller's physical USB or wireless polling rate." checks={['Live requestAnimationFrame sample count', 'Wired versus Bluetooth comparison', 'Browser and display conditions', 'Clear limits of the estimate']} notes={['Keep the same display refresh rate during comparisons.', 'Run each connection mode for several seconds.', 'Treat the result as browser sampling, not hardware polling.', 'Use a native hardware tester for true controller polling measurements.']} faq={faq} /></BaseLayout>
