---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found – Gamepad Tester" description="The page you requested could not be found. Return to Gamepad Tester to test your controller online." canonicalPath="/404/" noindex>
  <section class="error-page shell" aria-labelledby="error-title">
    <div class="error-card">
      <p class="error-code">404 / SIGNAL LOST</p>
      <h1 id="error-title">Page not found</h1>
      <p>This controller test route is not available. Return to the Gamepad Tester or open a focused diagnostic from the tool library.</p>
      <div class="error-actions">
        <a href="/">Back to Gamepad Tester</a>
        <a href="/tools/">Browse all tools</a>
      </div>
    </div>
  </section>
</BaseLayout>
