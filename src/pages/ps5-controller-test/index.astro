---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'Why is my PS5 controller shown as a generic gamepad?', answer: 'Browsers receive a standardized gamepad mapping from the operating system. The visible name and button labels can differ between USB, Bluetooth, Windows and macOS.' }, { question: 'Can I test the PS5 touchpad here?', answer: 'Touchpad and advanced DualSense features are not consistently available through the standard Gamepad API. The tester focuses on buttons, axes, triggers and supported rumble.' }];
---
<BaseLayout title="PS5 Controller Test Online – Test DualSense Buttons & Sticks" description="Test your PS5 DualSense controller online. Check buttons, analog sticks, triggers, D-pad and supported vibration directly in your browser with no download." faqs={faq}><ToolPage title="Test your DualSense. Button by button." description="Check a PS5 controller's face buttons, D-pad, sticks, triggers and browser-supported haptic feedback before you play or buy used." kicker="DEVICE TEST / PLAYSTATION 5" mode="ps5" intro="Use the browser Gamepad API to inspect a DualSense's visible inputs and understand which advanced features are available." checks={['Cross, circle, square and triangle', 'D-pad, shoulder buttons and sticks', 'L2 / R2 analog trigger travel', 'Browser-supported rumble output']} notes={['Try USB for the most predictable mapping.', 'Press a button after connecting over Bluetooth.', 'Compare the visible name with the raw API mapping.']} faq={faq} /></BaseLayout>
