---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'What is a normal deadzone?', answer: 'There is no universal number because controllers and games use different ranges. Use the visual center and the stability of the reading as a practical first check.' }, { question: 'Can software fix stick drift?', answer: 'Increasing a game deadzone can hide mild drift, but it does not repair worn hardware. Cleaning, calibration or replacement may be needed for severe drift.' }, { question: 'Is this a professional hardware test?', answer: 'No. This page analyzes the values exposed by your browser through the Gamepad API. It is a practical diagnostic, not a certified hardware measurement.' }];
---
<BaseLayout title="Gamepad Stick Drift Test – Check Deadzone & Joystick Drift" description="Run a free gamepad stick drift test online. Check joystick centering, deadzone, jitter and unwanted movement on Xbox, PlayStation, Switch and PC controllers." faqs={faq}><ToolPage title="Is your stick drifting? Find out in seconds." description="Stick drift happens when a controller reports movement while the stick is physically at rest. Read the live X/Y values and make unwanted offset easier to see." kicker="DIAGNOSTIC TOOL / 01" mode="drift" intro="A focused stick drift test that watches the analog center, deadzone and micro-movements from your controller in real time." checks={['Stick center offset at rest', 'Deadzone and small unwanted movement', 'Jitter or unstable analog readings', 'Movement across the full stick range']} notes={['Leave both sticks untouched for several seconds.', 'Compare the center before and after a full rotation.', 'Test wired and Bluetooth modes separately if needed.']} faq={faq} /></BaseLayout>
