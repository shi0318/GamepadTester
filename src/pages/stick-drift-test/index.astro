---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
import JoystickDriftGuide from '../../components/JoystickDriftGuide.astro';

const faq = [
  { question: 'What is a joystick drift test?', answer: 'A joystick drift test checks whether an analog stick reports movement while you are not touching it. This page measures center offset, jitter and deadzone-related movement from the browser Gamepad API.' },
  { question: 'How do I test joystick drift?', answer: 'Connect the controller, leave both sticks untouched, click Calibrate center, and wait for the readings to settle. Then move each stick through its range and run the circle test for a fuller check.' },
  { question: 'What is a normal drift reading?', answer: 'There is no universal number because controllers and games use different ranges. A stable center, low jitter and no unwanted movement are more useful than one universal threshold.' },
  { question: 'Can software fix joystick drift?', answer: 'Increasing a game deadzone can hide mild drift, but it does not repair worn hardware. Cleaning, calibration or replacement may be needed for severe drift.' },
  { question: 'Is this a professional hardware test?', answer: 'No. This joystick drift test analyzes the values exposed by your browser through the Gamepad API. It is a practical diagnostic, not a certified hardware measurement.' },
];
---
<BaseLayout title="Joystick Drift Test Online – Gamepad Stick Drift Checker" description="Free joystick drift test online for Xbox, PlayStation, Switch and PC controllers. Check stick center offset, deadzone, jitter and unwanted movement in your browser." canonicalPath="/stick-drift-test/" faqs={faq}>
  <ToolPage title="Joystick Drift Test Online" description="Use this joystick drift test to find movement that appears while the analog stick is physically at rest. Compare the live X/Y signal, center offset, jitter and circular range before deciding whether a controller needs cleaning, calibration or repair." kicker="JOYSTICK DIAGNOSTIC / 01" mode="drift" intro="A focused gamepad stick drift test for detecting unwanted joystick movement on Xbox, PlayStation, Switch and PC controllers." checks={['Joystick center offset while untouched', 'Deadzone and small unwanted movement', 'Jitter or unstable analog readings', 'Movement and angle coverage across the full stick range']} notes={['Connect the controller before starting the test.', 'Leave both sticks untouched while clicking Calibrate center.', 'Move one stick at a time during the circle test.', 'Compare USB and Bluetooth readings if the result is unexpected.']} faq={faq} />
  <JoystickDriftGuide />
</BaseLayout>
