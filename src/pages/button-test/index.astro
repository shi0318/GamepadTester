---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'How do I test every gamepad button?', answer: 'Connect your controller, press each face button, D-pad direction, bumper and stick click, then confirm the matching visual input and event counter respond.' }, { question: 'Why is one button not lighting up?', answer: 'The browser mapping may differ by controller or connection mode. Try USB, press the button again and check the raw Gamepad API data.' }];
---
<BaseLayout title="Gamepad Button Test Online – Check Every Controller Button" description="Test gamepad buttons online, including face buttons, D-pad, bumpers, stick clicks and analog inputs on Xbox, PlayStation, Switch and PC controllers." faqs={faq}><ToolPage title="Press every button. Miss nothing." description="A focused controller button test for dead inputs, stuck buttons, double presses and inconsistent mappings." kicker="DIAGNOSTIC TOOL / 02" mode="buttons" intro="Check every face button, D-pad direction, bumper, stick click and trigger with a clear live input map." checks={['Face buttons and D-pad directions', 'LB/RB bumpers and menu buttons', 'Left and right stick clicks', 'Pressed state and analog value']} notes={['Press each button once, then hold it briefly.', 'Use the event counter to spot missed inputs.', 'Compare the browser mapping with the raw snapshot.']} faq={faq} /></BaseLayout>
