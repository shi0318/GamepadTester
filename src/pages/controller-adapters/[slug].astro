---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdapterCard from '../../components/AdapterCard.astro';
import { ADAPTERS } from '../../data/adapter-library';
import { CONTROLLERS } from '../../data/controller-library';

export function getStaticPaths() {
  return ADAPTERS.map((adapter) => ({ params: { slug: adapter.slug }, props: { adapter } }));
}

const { adapter } = Astro.props;
const relatedControllers = CONTROLLERS.filter((controller) => adapter.relatedControllers.includes(controller.slug));
// Same-category siblings first, then fill from the rest. Category-only matching left the adapters
// with a unique category (DB9, multi-console) with no sibling links at all.
const otherAdapters = ADAPTERS.filter((item) => item.slug !== adapter.slug);
const relatedAdapters = [...otherAdapters.filter((item) => item.category === adapter.category), ...otherAdapters.filter((item) => item.category !== adapter.category)].slice(0, 3);
---

<BaseLayout title={`${adapter.name} Guide – Gamepad Adapter Compatibility`} description={`${adapter.name}: compare input and output protocols, target platforms, use cases and compatibility checks before choosing a controller adapter.`} canonicalPath={`/controller-adapters/${adapter.slug}/`} faqs={adapter.faqs} breadcrumbs={[{ name: 'Adapters', path: '/controller-adapters/' }, { name: adapter.name, path: `/controller-adapters/${adapter.slug}/` }]}>
  <section class="article-hero"><div class="shell article-hero-inner"><span class="subpage-kicker">{adapter.category.toUpperCase()}</span><h1>{adapter.name}</h1><p class="lede">{adapter.summary}</p><div class="profile-actions"><a class="primary-button" href="/controller-adapters/">Browse adapter finder <span>→</span></a><a class="secondary-button" href="/#tester">Test your controller</a></div></div></section>
  <section class="profile-summary shell"><div class="profile-facts"><div><span>Input</span><strong>{adapter.input}</strong></div><div><span>Output</span><strong>{adapter.output}</strong></div><div><span>Target</span><strong>{adapter.target}</strong></div><div><span>Category</span><strong>{adapter.category}</strong></div></div><div class="profile-note"><span class="panel-label">SIGNAL PATH</span><div class="adapter-flow-large"><span>{adapter.input}</span><b>→</b><span>{adapter.output}</span></div></div></section>
  <section class="profile-content shell"><article class="info-card profile-wide"><span class="panel-label">HOW IT WORKS</span><h2>What the adapter actually converts</h2><p>{adapter.howItWorks}</p></article><article class="info-card"><span class="panel-label">BEST FOR</span><h2>Where this adapter helps</h2><ul>{adapter.bestFor.map((item) => <li>{item}</li>)}</ul></article><article class="info-card"><span class="panel-label">BEFORE BUYING</span><h2>Compatibility checklist</h2><ul>{adapter.checkBeforeBuying.map((item) => <li>{item}</li>)}</ul></article><article class="info-card profile-wide"><span class="panel-label">INPUT DELAY</span><h2>Where the delay comes from</h2><p>{adapter.latency}</p></article></section>
  <section class="profile-content shell"><article class="info-card profile-wide"><span class="panel-label">VERIFY IT YOURSELF</span><h2>Four checks before you blame the adapter</h2><ol class="verify-list">{adapter.verify.map((step) => <li>{step}</li>)}</ol><p class="verify-links">Tools for these checks: <a class="inline-link" href="/button-test/">button test</a>, <a class="inline-link" href="/stick-drift-test/">joystick drift test</a>, <a class="inline-link" href="/trigger-test/">trigger test</a>, <a class="inline-link" href="/polling-rate-test/">polling rate test</a>, <a class="inline-link" href="/vibration-test/">vibration test</a>.</p></article><article class="info-card profile-wide"><span class="panel-label">HOW TO CHOOSE</span><h2>Test first, then bridge the gap</h2><p>Use the <a class="inline-link" href="/#tester">online gamepad tester</a> to verify the input device before adding an adapter. Record the controller name, mapping, button count, axes and rumble behavior. Then match those facts against the adapter's input requirements and the target platform's protocol.</p><div class="tool-callout"><strong>Important:</strong> Adapter compatibility changes by firmware, revision and host. Treat this page as a shortlist of questions to verify with the seller or manufacturer.</div></article></section>
  <section class="faq-section shell"><div class="section-heading"><div><span class="section-kicker">FAQ</span><h2>Questions about this adapter</h2></div></div><div class="faq-grid">{adapter.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>
  {relatedControllers.length > 0 && <section class="related-tools shell"><div class="section-heading"><div><span class="section-kicker">START WITH A DEVICE</span><h2>Controllers commonly used here</h2></div><a class="text-link" href="/controllers/">Open controller library →</a></div><div class="catalog-grid profile-related-grid">{relatedControllers.map((controller) => <article class="catalog-card"><div class="catalog-card-topline"><span class="catalog-badge">{controller.category}</span><span class="catalog-meta">{controller.connection}</span></div><h2><a class="catalog-card-link" href={`/controllers/${controller.slug}/`}>{controller.name}</a></h2><p>{controller.summary}</p><strong class="catalog-link">View compatibility →</strong></article>)}</div></section>}
  {relatedAdapters.length > 0 && <section class="related-tools shell"><div class="section-heading"><div><span class="section-kicker">OTHER DIRECTIONS</span><h2>Related adapter guides</h2></div></div><div class="catalog-grid profile-related-grid">{relatedAdapters.map((item) => <AdapterCard adapter={item} />)}</div></section>}
</BaseLayout>
