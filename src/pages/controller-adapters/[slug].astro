---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdapterCard from '../../components/AdapterCard.astro';
import { ADAPTERS } from '../../data/adapter-library';
import { CONTROLLERS } from '../../data/controller-library';

export function getStaticPaths() {
  return ADAPTERS.map((adapter) => ({ params: { slug: adapter.slug }, props: { adapter } }));
}

const { adapter } = Astro.props;
const relatedControllers = CONTROLLERS.filter((controller) => adapter.relatedControllers.includes(controller.slug));
const relatedAdapters = ADAPTERS.filter((item) => item.slug !== adapter.slug && item.category === adapter.category).slice(0, 3);
---

<BaseLayout title={`${adapter.name} Guide – Gamepad Adapter Compatibility`} description={`${adapter.name}: compare input and output protocols, target platforms, use cases and compatibility checks before choosing a controller adapter.`} canonicalPath={`/controller-adapters/${adapter.slug}/`}>
  <section class="article-hero"><div class="shell article-hero-inner"><span class="subpage-kicker">{adapter.category.toUpperCase()}</span><h1>{adapter.name}</h1><p class="lede">{adapter.summary}</p><div class="profile-actions"><a class="primary-button" href="/controller-adapters/">Browse adapter finder <span>→</span></a><a class="secondary-button" href="/#tester">Test your controller</a></div></div></section>
  <section class="profile-summary shell"><div class="profile-facts"><div><span>Input</span><strong>{adapter.input}</strong></div><div><span>Output</span><strong>{adapter.output}</strong></div><div><span>Target</span><strong>{adapter.target}</strong></div><div><span>Category</span><strong>{adapter.category}</strong></div></div><div class="profile-note"><span class="panel-label">SIGNAL PATH</span><div class="adapter-flow-large"><span>{adapter.input}</span><b>→</b><span>{adapter.output}</span></div></div></section>
  <section class="profile-content shell"><article class="info-card"><span class="panel-label">BEST FOR</span><h2>Where this adapter helps</h2><ul>{adapter.bestFor.map((item) => <li>{item}</li>)}</ul></article><article class="info-card"><span class="panel-label">BEFORE BUYING</span><h2>Compatibility checklist</h2><ul>{adapter.checkBeforeBuying.map((item) => <li>{item}</li>)}</ul></article><article class="info-card profile-wide"><span class="panel-label">HOW TO CHOOSE</span><h2>Test first, then bridge the gap</h2><p>Use the <a class="inline-link" href="/#tester">online gamepad tester</a> to verify the input device before adding an adapter. Record the controller name, mapping, button count, axes and rumble behavior. Then match those facts against the adapter's input requirements and the target platform's protocol.</p><div class="tool-callout"><strong>Important:</strong> Adapter compatibility changes by firmware, revision and host. Treat this page as a shortlist of questions to verify with the seller or manufacturer.</div></article></section>
  {relatedControllers.length > 0 && <section class="related-tools shell"><div class="section-heading"><div><span class="section-kicker">START WITH A DEVICE</span><h2>Controllers commonly used here</h2></div><a class="text-link" href="/controllers/">Open controller library →</a></div><div class="catalog-grid profile-related-grid">{relatedControllers.map((controller) => <a class="catalog-card" href={`/controllers/${controller.slug}/`}><div class="catalog-card-topline"><span class="catalog-badge">{controller.category}</span><span class="catalog-meta">{controller.connection}</span></div><h2>{controller.name}</h2><p>{controller.summary}</p><strong class="catalog-link">View compatibility →</strong></a>)}</div></section>}
  {relatedAdapters.length > 0 && <section class="related-tools shell"><div class="section-heading"><div><span class="section-kicker">OTHER DIRECTIONS</span><h2>Related adapter guides</h2></div></div><div class="catalog-grid profile-related-grid">{relatedAdapters.map((item) => <AdapterCard adapter={item} />)}</div></section>}
</BaseLayout>
