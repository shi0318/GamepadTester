---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'What do the trigger values mean?', answer: 'The browser reports the analog trigger travel between 0 and 1.00. A smooth increase shows the trigger is exposing pressure or travel data.' }, { question: 'Can I test adaptive trigger resistance?', answer: 'The standard Gamepad API can expose trigger travel but does not consistently control advanced resistance features.' }];
---
<BaseLayout title="Gamepad Trigger Test – Check LT, RT, L2 & R2 Pressure" description="Test controller trigger travel online. Check LT, RT, L2 and R2 analog pressure values from your Xbox, PS5, Switch or PC gamepad." faqs={faq}><ToolPage title="Test every squeeze." description="Inspect the live 0–1 range of your controller's analog triggers and make sure both sides report smooth travel." kicker="DIAGNOSTIC TOOL / 04" mode="triggers" intro="Press LT and RT or L2 and R2 and watch the live pressure bars respond from rest to full travel." checks={['Left and right trigger travel', 'Analog value from 0.00 to 1.00', 'Smoothness across the full range', 'Missing or stuck trigger signals']} notes={['Press slowly from rest to full travel.', 'Compare left and right trigger response.', 'Use the raw snapshot for exact current values.']} faq={faq} /></BaseLayout>
