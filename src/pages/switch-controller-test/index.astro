---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPage from '../../components/ToolPage.astro';
const faq = [{ question: 'Can I test a Switch Pro Controller in a browser?', answer: 'Yes, a Switch Pro Controller can expose its standard buttons and axes through the Gamepad API when paired and supported by the operating system.' }, { question: 'Why is my Joy-Con mapping unusual?', answer: 'Joy-Cons can appear as separate devices or use a different browser mapping depending on the pairing mode and operating system.' }];
---
<BaseLayout title="Switch Controller Test Online – Test Pro Controller & Joy-Con" description="Test Nintendo Switch Pro and Joy-Con controllers online. Check buttons, sticks, triggers, D-pad and supported vibration in a modern browser." faqs={faq}><ToolPage title="Check your Switch controller." description="Inspect Switch Pro, Joy-Con and compatible Bluetooth controller inputs in a clean browser-based test bench." kicker="DEVICE TEST / NINTENDO SWITCH" mode="switch" intro="Connect a Switch Pro Controller or Joy-Con and see whether its buttons, axes and supported feedback arrive correctly." checks={['A, B, X, Y and shoulder buttons', 'D-pad or directional input', 'Left and right analog sticks', 'Supported vibration and connection status']} notes={['Pair the controller before loading the page.', 'Press a button to wake the browser API.', 'Test Joy-Cons separately if they appear as two devices.']} faq={faq} /></BaseLayout>
