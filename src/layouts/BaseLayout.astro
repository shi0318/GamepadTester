---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SisterSites from '../components/SisterSites.astro';
import { SITE, FAQS, resolveBreadcrumbs, type Crumb } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageType?: 'home' | 'article';
  faqs?: { question: string; answer: string }[];
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  itemList?: { name: string; path: string; description?: string }[];
  itemListName?: string;
}

const { title, description, canonicalPath = Astro.url.pathname, pageType = 'article', faqs = [], noindex = false, breadcrumbs, itemList = [], itemListName } = Astro.props;
const canonical = new URL(canonicalPath, SITE.url).href;
const absolute = (path: string) => new URL(path, SITE.url).href;
const trail: Crumb[] = pageType === 'home' || noindex ? [] : [{ name: 'Home', path: '/' }, ...(breadcrumbs ?? resolveBreadcrumbs(canonicalPath))];
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name, url: `${SITE.url}/`, logo: { '@type': 'ImageObject', url: `${SITE.url}/gamepad-tester-logo.png`, width: 512, height: 512, caption: 'Gamepad Tester controller logo' } },
];

if (pageType === 'home') {
  graph.push(
    { '@type': 'WebSite', '@id': `${canonical}#website`, name: SITE.name, url: canonical, description, publisher: { '@id': `${SITE.url}/#organization` } },
    { '@type': 'WebApplication', '@id': `${canonical}#app`, name: title, url: canonical, applicationCategory: 'GameApplication', operatingSystem: 'Web', browserRequirements: 'Requires a modern desktop browser with Gamepad API support; controller must already be connected by the operating system.', isAccessibleForFree: true, description, featureList: ['Button and D-pad testing', 'Browser-side stick drift and deadzone check', 'Trigger pressure readout', 'Supported controller vibration test', 'Raw Gamepad API data'], publisher: { '@id': `${SITE.url}/#organization` } },
  );
} else {
  graph.push({ '@type': 'WebApplication', '@id': `${canonical}#app`, name: title, url: canonical, applicationCategory: 'GameApplication', operatingSystem: 'Web', isAccessibleForFree: true, description, publisher: { '@id': `${SITE.url}/#organization` } });
}

const activeFaqs = faqs.length ? faqs : pageType === 'home' ? FAQS : [];
if (activeFaqs.length) graph.push({ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: activeFaqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) });

if (trail.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: trail.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, name: crumb.name, item: absolute(crumb.path) })),
  });
}

if (itemList.length) {
  graph.push({
    '@type': 'ItemList',
    '@id': `${canonical}#itemlist`,
    name: itemListName ?? title,
    numberOfItems: itemList.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: itemList.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, url: absolute(item.path), ...(item.description ? { description: item.description } : {}) })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CPMJD81RYB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CPMJD81RYB');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageType === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og/gamepad-tester-1200x630.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gamepad Tester controller logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og/gamepad-tester-1200x630.png`} />
    <meta name="twitter:image:alt" content="Gamepad Tester — browser controller diagnostics" />
    <meta name="theme-color" content="#081017" />
    <link rel="icon" href="/gamepad-tester-favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/gamepad-tester-favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/gamepad-tester-favicon-96.png" sizes="96x96" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">{trail.length > 1 && <Breadcrumbs trail={trail} />}<slot /></main>
    <SisterSites />
    <Footer />
    <script>import '../scripts/theme.js';</script>
  </body>
</html>
